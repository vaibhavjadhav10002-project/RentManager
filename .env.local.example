# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Push Notifications (PWA) ────────────────────────────────────────────────
# Service role key: Supabase Dashboard → Project Settings → API → service_role
# (server-only — never expose this with NEXT_PUBLIC_, it bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Ready to use as-is, or generate your own with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BAG3ThOpRLoRZ7tkNOAFd-Veef47TzGb1aheTYkXDzs8WjD8D01sdRv0aMlyl-phzUDuwDu6cRYzOvUML4lKu8k
VAPID_PRIVATE_KEY=9OSovZEJlrlsBF0qyPxtTNUaQN7OevrtRMKdYB8Lthg
VAPID_SUBJECT=mailto:owner@example.com

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Super Admin (reference only) ────────────────────────────────────────────
# NOT currently read by the app — the super_admin role is granted manually via
# supabase/03_manual_create_users.sql, not by matching this email at login.
# Kept here as a placeholder for that automatic-promotion behavior if it's
# built in a future phase; setting this alone does nothing today.
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=your-admin-email@gmail.com

# ─── Automatic Backup (Phase 5.13) ──────────────────────────────────────────
# Any random string — Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` when it triggers /api/cron/automatic-backup.
# Generate one with `openssl rand -hex 32` or similar.
CRON_SECRET=your-random-secret-here

# ─── Mobile App (Capacitor) ──────────────────────────────────────────────────
# The production URL the Android/iOS app shell loads (see capacitor.config.ts).
# Must be the real deployed domain — not localhost — for a built APK/IPA.
CAPACITOR_SERVER_URL=https://your-app.vercel.app

# Native push relay (FCM/APNs) — NOT required to build/run the app; only
# needed once you want native push delivery to actually work (see
# src/app/api/push/send/route.ts and MOBILE_BUILD_REPORT.md). Leave unset
# until then; the app runs fine without them.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
