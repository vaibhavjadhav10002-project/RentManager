# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — real secrets live in .env.local, never commit it
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android release signing — NEVER commit these (Release Automation)
# The real keystore only ever exists as the ANDROID_KEYSTORE_BASE64 GitHub
# Secret and a temp file on the CI runner; it must never touch git history.
*.keystore
*.jks
*.p12
android/**/keystore.properties
android/app/release
keystore-base64.txt
*.keystore.base64
*.keystore.b64

# CI-generated build artifacts (not source)
android/app/build/outputs/apk/
android/app/build/outputs/bundle/

.vercel
.env*
